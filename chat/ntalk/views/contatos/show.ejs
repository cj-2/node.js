<%	include	../header	%>
<header>
  <h1>Ntalk</h1>
  <h4>Dados do contato</h4>
</header>
<section>
  <form action="/contato/<%- id %>?_method=delete" method="post">
    <p>
      <label>Nome:</label>
      <%- contato.nome %>
    </p>
    <p>
      <label>Email:</label>
      <%- contato.email %>
    </p>
    <button type="submit">Excluir</button>
    <a href="/contato/<%- id %>/editar">Editar</a>
  </form>
</section>
<%	include	../exit	%>
<%	include	../footer	%>
