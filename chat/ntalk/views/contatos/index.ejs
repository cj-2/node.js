<%	include	../header	%>
<header>
  <h1>Ntalk</h1>
  <h4>Agenda de contatos</h4>
</header>
<section>
  <p>Bem-vindo	<%-	usuario.nome	%></p>
</section>
<section>
  <form action="/contato" method="post">
    <input type="text" name="contato[nome]" placeholder="Nome:">
    <input type="text" name="contato[email]" placeholder="Email:">
    <button type="submit">Cadastrar</button>
  </form>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Ação</th>
      </tr>
    </thead>
    <tbody>
      <% contatos.forEach(function(contato, index){ %>
        <tr>
          <th><%- contato.nome %></th>
          <th><%- contato.email %></th>
          <th>
            <a href="/contato/<%- index %>">Detalhes</a>
              <br>
            <a href="/chat" id="chat_<%- contato.email %>">Conversar</a>
          </th>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<%	include	notify_script %>
<%	include	../exit	%>
<%	include	../footer	%>
